# --- Database (Vercel Postgres / Neon) ---
# The pooled connection string. On Vercel this is provided automatically when
# you attach a Postgres store. Locally, run `vercel env pull .env.local` after
# linking, or paste the value from the Vercel dashboard here.
POSTGRES_URL="postgres://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth ---
# Secret used to sign/verify the session JWT. Must be at least 32 characters and
# must not contain "change-me" — the app refuses to start a session otherwise.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"

# --- Optional ---
# Funds target in Ksh, used to seed settings.funds_goal on `npm run db:init`.
# Only read by the init script; changing it later means editing the settings row.
FUNDS_GOAL="100000"
